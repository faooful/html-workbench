{
  "name": "design-md-workbench",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "build:renderer": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -c tailwind.config.js -i renderer/src/styles.css -o renderer/app.css",
    "build:js": "esbuild renderer/src/App.jsx --bundle --format=iife --global-name=DesignMdApp --outfile=renderer/app.bundle.js --jsx=automatic --loader:.js=jsx",
    "test:ui": "npm run build:renderer && playwright test",
    "test:visual": "npm run build:renderer && playwright test tests/ui.visual.spec.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Local-first DESIGN.md workbench for AI-agent implementation guidance.",
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@google/design.md": "^0.1.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^41.3.0",
    "js-yaml": "^4.1.1",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-resizable-panels": "^4.10.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "autoprefixer": "^10.5.0",
    "esbuild": "latest",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.17"
  }
}
